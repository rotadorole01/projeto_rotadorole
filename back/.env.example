
# Porta da API
API_PORT=3600

# Configurações do banco de dados MySQL
DB_TYPE=mysql
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_PORT=3306
DB_DATABASE=rotadorole

# Chave de segurança JWT (cada desenvolvedor deve gerar a sua)
JWT_SECRET=COLOQUE_SUA_CHAVE_GERADA_AQUI

# ID da única conta Empresa/CNPJ aprovada para acessar o painel
# Deixe vazio para bloquear todas as contas
PATROCINADOR_APROVADO_ID=9
